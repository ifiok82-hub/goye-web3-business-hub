{
  "name": "goye-web3-business-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"const {spawn}=require('child_process');const a=process.argv.slice(1).map(x=>x==='--host'?'-H':x==='--port'?'-p':x);const c=spawn(process.execPath,[require.resolve('next/dist/bin/next'),'dev',...a],{stdio:'inherit'});c.on('exit',k=>process.exit(k??0))\" --",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "0.441.0"
  },
  "devDependencies": {
    "@types/node": "20.11.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "5.4.5"
  }
}
